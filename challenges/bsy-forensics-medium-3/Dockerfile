FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server sudo cron iproute2 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN useradd -m -s /bin/bash analyst && useradd -m -s /bin/bash ops && useradd -m -s /bin/bash science && useradd -m -s /bin/bash telemetry && echo 'analyst:MoonDust-74' | chpasswd && echo 'ops:Ops-Shift-31' | chpasswd && echo 'science:Science-Log-22' | chpasswd && echo 'telemetry:Telemetry-Log-19' | chpasswd && printf 'analyst ALL=(ALL) NOPASSWD:ALL\n' >/etc/sudoers.d/analyst && chmod 0440 /etc/sudoers.d/analyst
RUN mkdir -p /run/sshd /home/analyst/.ssh /home/ops/.ssh /home/science/.ssh /home/telemetry/.ssh && chmod 700 /home/analyst/.ssh /home/ops/.ssh /home/science/.ssh /home/telemetry/.ssh && chown -R analyst:analyst /home/analyst/.ssh && chown -R ops:ops /home/ops/.ssh && chown -R science:science /home/science/.ssh && chown -R telemetry:telemetry /home/telemetry/.ssh
RUN printf '%s\n' 'PasswordAuthentication yes' 'PubkeyAuthentication yes' 'PermitRootLogin no' 'UsePAM no' 'LogLevel VERBOSE' >/etc/ssh/sshd_config.d/lab.conf
RUN ssh-keygen -q -t ed25519 -N '' -f /tmp/intruder-key && awk '{print $1, $2 " incident-QlNZe3FNeFhzZ2lvWmdGc1RhdEtWSUZ0Zk5McEZKRk9JTmJwfQ=="}' /tmp/intruder-key.pub >/home/analyst/.ssh/authorized_keys && chown analyst:analyst /home/analyst/.ssh/authorized_keys && chmod 600 /home/analyst/.ssh/authorized_keys && KEY_FP=$(ssh-keygen -lf /tmp/intruder-key.pub | awk '{print $2}') && rm -f /tmp/intruder-key /tmp/intruder-key.pub && touch -d '2026-11-14 03:12:00 UTC' /home/analyst/.ssh/authorized_keys && printf '%s\n' 'Nov 14 02:58:10 lunar-node sshd[1842]: Accepted password for ops from 172.20.0.8 port 42110 ssh2' 'Nov 14 03:04:33 lunar-node sudo: ops : TTY=pts/0 ; PWD=/home/ops ; USER=root ; COMMAND=/usr/bin/systemctl status cron' "Nov 14 03:12:41 lunar-node sshd[2197]: Accepted publickey for analyst from 10.77.4.23 port 51822 ssh2: ED25519 $KEY_FP" 'Nov 14 03:13:02 lunar-node sudo: analyst : TTY=pts/1 ; PWD=/home/analyst ; USER=root ; COMMAND=/usr/bin/id' 'Nov 14 04:02:19 lunar-node sshd[2551]: Accepted password for science from 172.20.0.12 port 43302 ssh2' 'Nov 14 04:03:01 lunar-node sudo: science : TTY=pts/2 ; PWD=/home/science ; USER=root ; COMMAND=/usr/bin/tail -n 20 /var/log/syslog' >/var/log/auth.log && chmod 640 /var/log/auth.log && chown root:adm /var/log/auth.log
RUN printf '%s\n' '15 2 * * * root /usr/local/bin/rotate-lab-notes' >/etc/cron.d/lab-notes && chmod 644 /etc/cron.d/lab-notes && printf '%s\n' '0 6 * * 1 ops /usr/bin/find /srv/telemetry -type f -mtime +30 -delete' >/etc/cron.d/telemetry-cleanup && chmod 644 /etc/cron.d/telemetry-cleanup
RUN printf '%s\n' 'ssh lunar-node "uptime"' 'sudo systemctl status cron' 'tail -n 10 /var/log/syslog' >/home/ops/.bash_history && printf '%s\n' 'python3 -m http.server 8080' 'sudo journalctl -u instrument-reader --since yesterday' 'exit' >/home/science/.bash_history && printf '%s\n' 'sudo -l' 'date -u' 'ssh ops@lunar-node' 'exit' >/home/analyst/.bash_history && printf '%s\n' 'find /srv/telemetry -type f -mtime -1' 'df -h' 'exit' >/home/telemetry/.bash_history && chown analyst:analyst /home/analyst/.bash_history && chown ops:ops /home/ops/.bash_history && chown science:science /home/science/.bash_history && chown telemetry:telemetry /home/telemetry/.bash_history
COPY start-services.sh /usr/local/sbin/start-services
RUN chmod 0755 /usr/local/sbin/start-services && ssh-keygen -A
