Port 1397
ListenAddress 0.0.0.0
Protocol 2

HostKey /opt/shellm/docker_config/ssh_host_keys/ssh_host_rsa_key
HostKey /opt/shellm/docker_config/ssh_host_keys/ssh_host_ed25519_key

PermitRootLogin no
PasswordAuthentication yes
PubkeyAuthentication no
KbdInteractiveAuthentication no
UsePAM yes

PidFile /opt/shellm/docker_config/sshd_honeypot.pid

X11Forwarding no
AllowTcpForwarding no
AllowAgentForwarding no
PermitTunnel no

AcceptEnv LANG LC_*

Subsystem sftp /usr/lib/openssh/sftp-server

Match User honeypot
    ForceCommand /opt/shellm/docker_config/run_shellm.sh
    X11Forwarding no
    AllowTcpForwarding no
