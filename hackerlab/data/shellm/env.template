# ---- Pick ONE provider and set its key below ----
# PROVIDER must be one of: einfra | openai | groq | ollama
PROVIDER=einfra
MODEL=gpt-oss-120b

# MODEL must match the provider you picked above. Examples that are known to work:
#   einfra: gpt-oss-120b
#   openai: gpt-4o-mini  (or any model your OpenAI key has access to)
#   groq:   openai/gpt-oss-120b   (list all available models: curl https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY")
#   ollama: whatever you've pulled, e.g. llama3.1:8b

# e-INFRA (CESNET) - https://chat.ai.e-infra.cz
EINFRA_API_KEY=

# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Groq - free tier, https://console.groq.com/keys
GROQ_API_KEY=

# Ollama (local/remote), only used if PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# ---- Honeypot SSH login (what classmates connect with) ----
HONEYPOT_USER=honeypot
HONEYPOT_PASSWORD=changeme123

# Port the honeypot sshd listens on. Default 1397 avoids clashing with
# Cowrie's 2222 and your container's own real sshd on 22. Change this if it
# conflicts with something else, or just to pick your own. After changing,
# re-run entrypoint.sh to apply it (restarts the honeypot sshd on the new port).
PORT=1397
